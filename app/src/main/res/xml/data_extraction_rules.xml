<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware-Keystore encrypted vault file and local Wi-Fi tokens -->
        <exclude domain="file" path="vault_credentials.enc" />
        <exclude domain="file" path="datastore/controle_bt_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault_credentials.enc" />
        <exclude domain="file" path="datastore/controle_bt_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
