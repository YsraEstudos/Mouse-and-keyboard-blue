<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_open_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="Controle BT"
        android:textColor="#22D3EE"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_btn_play"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:backgroundTint="#1E293B"
        android:text="⏯"
        android:textColor="#F8FAFC"
        android:textSize="14sp" />

    <Button
        android:id="@+id/widget_btn_vol_down"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:backgroundTint="#1E293B"
        android:text="Vol-"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <Button
        android:id="@+id/widget_btn_vol_up"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:backgroundTint="#1E293B"
        android:text="Vol+"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <Button
        android:id="@+id/widget_btn_jiggler"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="3dp"
        android:layout_weight="1"
        android:backgroundTint="#0891B2"
        android:text="Jig"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
